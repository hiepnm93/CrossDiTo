<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:checkedButton="@+id/tabReader">

        <RadioButton
            android:id="@+id/tabReader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_reader"
            android:textStyle="bold"
            android:gravity="center" />

        <RadioButton
            android:id="@+id/tabWeather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_weather"
            android:textStyle="bold"
            android:gravity="center" />
    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Reader tab: connection, auto-send, sync log. -->
        <ScrollView
            android:id="@+id/pageReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/readerAddressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:typeface="monospace"
                    android:textSize="13sp"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect" />

                <CheckBox
                    android:id="@+id/autoSendCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_send" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sync_log"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/syncLogView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:typeface="monospace"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Weather tab: fetch + manual form + send. -->
        <ScrollView
            android:id="@+id/pageWeather"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/fetchButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fetch_weather" />

                <TextView
                    android:id="@+id/fetchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/waiting" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/weather_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/locationField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/location"
                    android:inputType="text"
                    android:text="Hanoi" />

                <EditText
                    android:id="@+id/temperatureField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/temperature"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="27" />

                <EditText
                    android:id="@+id/feelsLikeField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/feels_like"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="29" />

                <EditText
                    android:id="@+id/tempMinField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/temp_min"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="24" />

                <EditText
                    android:id="@+id/tempMaxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/temp_max"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="30" />

                <EditText
                    android:id="@+id/humidityField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/humidity"
                    android:inputType="number"
                    android:text="76" />

                <Spinner
                    android:id="@+id/conditionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/send" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
