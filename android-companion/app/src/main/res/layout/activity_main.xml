<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <Button
            android:id="@+id/fetchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fetch_weather" />

        <TextView
            android:id="@+id/fetchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waiting" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/weather_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/locationField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/location"
            android:inputType="text"
            android:text="Hanoi" />

        <EditText
            android:id="@+id/temperatureField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/temperature"
            android:inputType="numberDecimal|numberSigned"
            android:text="27" />

        <EditText
            android:id="@+id/feelsLikeField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/feels_like"
            android:inputType="numberDecimal|numberSigned"
            android:text="29" />

        <EditText
            android:id="@+id/tempMinField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/temp_min"
            android:inputType="numberDecimal|numberSigned"
            android:text="24" />

        <EditText
            android:id="@+id/tempMaxField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/temp_max"
            android:inputType="numberDecimal|numberSigned"
            android:text="30" />

        <EditText
            android:id="@+id/humidityField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/humidity"
            android:inputType="number"
            android:text="76" />

        <Spinner
            android:id="@+id/conditionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/autoSendCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_send" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/send" />
    </LinearLayout>
</ScrollView>
